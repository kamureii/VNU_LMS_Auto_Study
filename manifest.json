{
  "manifest_version": 3,
  "name": "VNU LMS Auto Study",
  "version": "0.1.3",
  "description": "Tự mở từng bài, treo đủ thời gian yêu cầu và chuyển bài tiếp theo trên lms.vnu.edu.vn",
  "permissions": ["storage", "notifications"],
  "host_permissions": ["https://lms.vnu.edu.vn/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://lms.vnu.edu.vn/*"],
      "js": ["content/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://lms.vnu.edu.vn/*"],
      "js": ["content/runner.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
